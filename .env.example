# ==============================================================================
# SYNCROZZ SES v4.5 — KPMBP SOAR 2026 ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=3000

# ------------------------------------------------------------------------------
# 1. FIREBASE ADMIN & PERSISTENT STORAGE (WAJIB UNTUK PRODUKSI VERCEL)
# ------------------------------------------------------------------------------
# Masukkan keseluruhan fail Service Account JSON (dalam bentuk satu baris teks JSON atau Base64).
# Backend membaca project_id, client_email, dan private_key secara automatik dari pemboleh ubah ini.
FIREBASE_SERVICE_ACCOUNT=

# ------------------------------------------------------------------------------
# 2. OVERRIDE PILIHAN (DITENTUKAN SECARA AUTOMATIK JIKA TIDAK DIISI)
# ------------------------------------------------------------------------------
# Nilai-nilai di bawah sudah mempunyai nilai lalai yang disahkan dalam firebase-applet-config.json.
# Hanya tetapkan jika anda ingin menukar ke pangkalan data atau bucket lain.
# FIREBASE_PROJECT_ID=gen-lang-client-0981591806
# FIRESTORE_DATABASE_ID=ai-studio-teamkpmbp-bd501981-2a65-4671-892c-6de5c1a9cd1c
# FIREBASE_STORAGE_BUCKET=gen-lang-client-0981591806.firebasestorage.app

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (PILIHAN)
# ------------------------------------------------------------------------------
# Diperlukan hanya untuk klasifikasi dan cadangan tag poster pintar secara automatik.
GEMINI_API_KEY=

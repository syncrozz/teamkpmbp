rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is user an authorized administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'khaikerr@gmail.com' ||
        request.auth.token.email == 'kpmbppsn@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection validation test path
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Portal global settings
    match /portal/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Navigation Tabs
    match /tabs/{tabId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Competition Schedules
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documents & References
    match /documents/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Event Information & Rundowns
    match /eventSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Locations & Movement
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Official Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins List
    match /admins/{adminUid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
